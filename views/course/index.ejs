<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Courses</title>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>Course List</h1>
    <% if(!courses.length === 0){ %>
        <% for(let oneCourse of courses){ %>
            <div class="course-div">
                <h3><%= oneCourse.name %></h3> <p><b>School: </b> <%= oneCourse.school.name %></p>
                <p><b>Description: </b> <%= oneCourse.description %></p>
                <a href="/courses/<%= oneCourse._id %>">See Details</a>
            </div>
        <% } %>
    <% }else{ %>
        <h2>No courses available</h2>
    <% } %>
</body>
</html>