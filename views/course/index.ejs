<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Courses</title>
    <link rel="stylesheet" href="/css/custom.css">
    <script defer src="/bootstrap-js/bootstrap.bundle.min.js"></script>
    <script defer src="/js/search.js"></script>
</head>
<body>
    <%- include('../partials/navbar') %>
    <div class="container pt-5">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <h1 class="page-header">Course List</h1>
            <% if(user.role === 'admin'){ %>
                <a href="/courses/new" class="btn btn-primary">+ Create New User</a>
            <% } %>
        </div>

        <div class="px-3">
            <div class="mb-3">
                <input id="search" class="form-control" type="text" placeholder="Search course name">
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0 display-table">
                    <tr class="table-header table-primary">
                        <th>Course Name</th>
                        <th>School</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                    <% if(courses.length === 0){ %>
                        <tr>
                            <td colspan="3" class="text-muted py-4">No courses found.</td>
                        </tr>
                    <% } %>
                    <% for(let oneCourse of courses){ %>
                        <tr class="table-row">
                            <td class="fw-semibold"><%= oneCourse.name %></td>
                            <td><%= oneCourse.school.name %></td>
                            <td><%= oneCourse.description %></td>
                            <td><a href="/courses/<%= oneCourse._id %>" class="btn btn-sm btn-outline-primary">See Details</a></td>
                        </tr>
                    <% } %> 
                </table>
            </div>
        </div>
    </div>
</body>
</html>