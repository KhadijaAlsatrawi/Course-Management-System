<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Course Details</title>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>Course Details</h1>
    <h3>Name: <%= course.name %></h3>
    <p><b>School: </b><%= course.school.name %></p>
    <p><b>Description: </b><%= course.description %></p>

    <% if(user.role === 'admin'){ %>
        <a href="/courses/<%= course._id %>/update">Update Course</a>
        <form action="/courses/<%= course._id %>?_method=DELETE" method="post">
            <button>Delete Course</button>
        </form>
    <% } %>

    <h2>Sections</h2>
    <% if(user.role === 'admin'){ %>
        <a href="/sections/new/<%= course._id %>">Add Section</a>
    <% }%>
    <ul>
        <% if(!sections){ %>
            <% for(let oneSection of sections){ %>
                <li>
                    <b>Location: </b> <%= oneSection.location %>
                    <b>Day: </b> <%= oneSection.dayOfWeek %>
                    <b>Time: </b> <%= oneSection.time %>
                    <b>Tutor: </b> <%= oneSection.tutor.username %>
                    <b>Registerd: </b> <%= oneSection.students.length %>

                    <% if(user.role === 'admin'){ %>
                        <a href="/sections/<%= oneSection._id %>/update">Update Section</a>
                        <form action="/sections/<%= oneSection._id %>?_method=DELETE" method="post">
                            <button>Delete Section</button>
                        </form>
                    <% }else if (user.role === 'student') { %>
                    <form action="/sections/<%= oneSection._id %>/register" method="post">
                        <button>Register in section</button>
                    </form>
                    <% } %>
                </li>
            <% } %>
        <% }else{ %>
            <h3>No Available Sections</h3>
        <% } %>
    </ul>
</body>
</html>