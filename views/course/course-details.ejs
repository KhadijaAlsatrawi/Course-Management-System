<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Course Details</title>
    <link rel="stylesheet" href="/css/custom.css">
    <script defer src="/bootstrap-js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../partials/navbar') %>
    <div class="container py-5">

        <h1>Course Details</h1>

        <div class="p-3 m-3">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <span class="badge bg-secondary mb-2"><%= course.school.name %></span>
                    <h1 class="h2 mb-0"><%= course.name %></h1>
                </div>
                <% if(user){ %>
                    <% if(user.role === 'admin'){ %>
                        <div class="d-flex gap-2">
                            <a href="/courses/<%= course._id %>/update" class="btn btn-outline-primary">Update Course</a>
                            <form action="/courses/<%= course._id %>?_method=DELETE" method="post">
                                <button class="btn btn-outline-danger">Delete Course</button>
                            </form>
                        </div>
                    <% } %>
                <% } %>
            </div>

            <hr class="my-4">

            <h2 class="h6 text-uppercase text-muted mb-2">Description</h2>
            <p class="mb-0"><%= course.description %></p>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <h2 class="page-header">Sections</h2>
            <% if(user){ %>
                <% if(user.role === 'admin'){ %>
                    <a href="/sections/new/<%= course._id %>"class="btn btn-primary">+ Create New Section</a>
                <% }%>
            <% }%>
        </div>
        <div class="px-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0 display-table">
                    <tr class="table-header table-primary">
                        <th>Location</th>
                        <th>Day</th>
                        <th>Time</th>
                        <th>Tutor</th>
                        <th>Actions</th>
                    </tr>

                <% if(sections.length === 0){ %>
                    <tr>
                        <td colspan="5" class="text-muted py-4">No sections found.</td>
                    </tr>
                <% } %>
                    
                <% for(let oneSection of sections){ %>
                    <tr class="table-row">
                        <td><%= oneSection.location %></td>
                        <td><%= oneSection.dayOfWeek %></td>
                        <td><%= oneSection.time %></td>
                        <td><%= oneSection.tutor.username %></td>
                        <td>
                            <div class="d-flex justify-content-center gap-2">
                                <% if(user){ %>
                                    <% if(user.role === 'admin'){ %>
                                        <a href="/sections/<%= oneSection._id %>/update" 
                                            class="btn btn-sm btn-outline-primary">Update</a>
                                        <form action="/sections/<%= oneSection._id %>?_method=DELETE" method="post">
                                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    <% }else if (user.role === 'student') { %>
                                        <% const registerd = oneSection.students.find(oneStudent=>oneStudent.equals(user._id)) %>
                                        <% if(registerd){ %>
                                            <form action="/sections/<%= oneSection._id %>/unregister" method="post">
                                                <button class="btn btn-sm btn-outline-primary" >Unregister</button>
                                            </form>
                                        <% }else{ %>
                                            <form action="/sections/<%= oneSection._id %>/register" method="post"></form>
                                                <button class="btn btn-sm btn-outline-primary" >Register</button>
                                            </form>
                                        <% } %>
                                        <div>
                                            <%= error %>
                                        </div>
                                    <% } %>
                                <% }else{ %>
                                    <a href="/auth/sign-in" 
                                            class="btn btn-sm btn-outline-primary">Sign in</a>
                                <% } %>
                            </div>
                        </td>
                <% } %>
                    
            </div>
        </div>
    </div>
</body>
</html>