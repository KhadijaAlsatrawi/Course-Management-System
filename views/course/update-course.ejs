<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Course</title>
    <link rel="stylesheet" href="/css/custom.css">
    <script defer src="/bootstrap-js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../partials/navbar') %>
    
    <div class="container py-5">
    
        <h1>Update Course</h1>

        <form action="/courses/<%= course._id %>?_method=PUT" method="post">
            <div class="form-control border border-primary my-2">

                <label for="name">Course name: </label>
                <input 
                    name="name"
                    id="name"
                    type="text"
                    required
                    class="form-control border border-primary my-2">

                <label for="description">Description: </label>
                <textarea 
                    name="description"
                    id="description"
                    required
                    class="form-control border border-primary my-2"></textarea>

                <label for="school">School: </label>
                <select name="school" id="school" required class="form-control border border-primary">
                    <% for (let oneSchool of schools){ %>
                        <option value="<%= oneSchool._id %>"><%= oneSchool.name %></option>
                    <% } %>
                </select>

                <div>
                    <% if(error){ %>
                        <%= error %>
                    <% } %>
                </div>

                <button class="btn btn-primary my-2">Update Course</button>
            </div>
        </form>
    </div>
</body>
</html>