<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Sections</title>
    <link rel="stylesheet" href="/css/custom.css">
    <script defer src="/bootstrap-js/bootstrap.bundle.min.js"></script>
    <script defer src="/js/search.js"></script>
</head>
<body>
    <%- include('../partials/navbar') %>
    <div class="container py-5">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <h1 class="h2 mb-0">My Sections</h1>
            <a href="/courses" class="btn btn-primary">Course List</a>
        </div>

        <div class="px-3">
            <div class="mb-3">
                <input id="search" class="form-control" type="text" placeholder="Search course name">
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0 display-table">
                    <tr class="table-header table-primary">
                        <th>Course</th>
                        <th>Location</th>
                        <th>Day</th>
                        <th>Time</th>
                        <th>Tutor</th>
                    </tr>
                    <% if(sections.length === 0){ %>
                        <tr>
                            <td colspan="5" class="text-muted py-4">No sections found.</td>
                        </tr>
                    <% } %>
                    <% for(let oneSection of sections){ %>
                        <tr class="table-row">
                            <td><%= oneSection.course.name %></td>
                            <td><%= oneSection.location %></td>
                            <td><%= oneSection.dayOfWeek %></td>
                            <td><%= oneSection.time %></td>
                            <td><%= oneSection.tutor.username %></td>
                        </tr>
                    <% } %>
                </table>
            </div>
        </div>
    </div>
</body>
</html>