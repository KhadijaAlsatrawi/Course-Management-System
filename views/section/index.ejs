<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Sections</title>
    <script defer src="/js/search.js"></script>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>My Sections</h1>
    <% if(!sections.length == 0){ %>
        <div>
            <input id="search" type="text" placeholder="Search course name">
        </div>
        <table class="display-table">
            <tr class="table-header">
                <th>Course</th>
                <th>Location</th>
                <th>Day</th>
                <th>Time</th>
                <th>Tutor</th>
            </tr>
            <% for(let oneSection of sections){ %>
                <tr class="table-row">
                    <td><%= oneSection.course.name %></td>
                    <td><%= oneSection.location %></td>
                    <td><%= oneSection.dayOfWeek %></td>
                    <td><%= oneSection.time %></td>
                    <td><%= oneSection.tutor.username %></td>
                </tr>
            <% } %>
        </table>
    <% }else{ %>
        <h3>No Available Sections</h3>
    <% } %>

</body>
</html>