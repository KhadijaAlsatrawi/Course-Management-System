<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New User</title>
    <link rel="stylesheet" href="/css/custom.css">
    <script defer src="/bootstrap-js/bootstrap.bundle.min.js"></script>
  </head>
  <body>
    <%- include('../partials/navbar') %>

    <div class="container py-5">
      <h1>Create a new User</h1>


      <form action="/user" method="post">
        <div class="form-control border border-primary my-2">

          <label for="username">Username:</label>
          <input 
          type="text" 
          name="username" 
          id="username" 
          class="form-control border border-primary my-2"/>

          <label for="email">Email:</label>
          <input 
          type="email" 
          name="email" 
          id="email" 
          class="form-control border border-primary my-2"/>

          <label for="password">Password:</label>
          <input 
          type="password" 
          name="password" 
          id="password" 
          class="form-control border border-primary my-2"/>

          <label for="confirmPassword">Confirm Password:</label>
          <input 
          type="password" 
          name="confirmPassword" 
          id="confirmPassword" 
          class="form-control border border-primary my-2"/>

          <label for="role">Role: </label>
          <select name="role" id="role"
            class="form-control border border-primary my-2">
            <% for(oneRole of roles){ %>
                <option value="<%= oneRole._id %>"><%= oneRole.name %></option>
            <% } %>
          </select>
          <div>
            <% if(error){ %>
                <%= error %>
            <% } %>
          </div>
          <button class="btn btn-primary my-2" type="submit">Create User </button>

        </div>
      </form>
    </div>
  </body>
</html>
