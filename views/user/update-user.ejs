<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Update User</title>
    <link rel="stylesheet" href="/css/custom.css">
    <script defer src="/bootstrap-js/bootstrap.bundle.min.js"></script>
    <script defer src="/js/imagePreview.js"></script>
  </head>
  <body>
    <%- include('../partials/navbar') %>

    <div class="container py-5">
      <h1>Update <%= user.username %></h1>

      <form action="/user/<%= user._id %>?_method=PUT" method="post" enctype="multipart/form-data">
        <div class="form-control border border-primary my-2 flex">
          <img id="imagePreview" src="<%= user.profileImg %>?v=<%= user.updatedAt ? user.updatedAt.getTime() : '' %>"
          alt="Preview" style="max-width: 300px;">

          <input type="file" id="fileInput" accept="image/*"
           class="form-control border border-primary my-2"
           name="profileImg">

          <label for="email">Email:</label>
          <input type="email" name="email" id="email"
           class="form-control border border-primary my-2"
           value="<%= user.email %>">
            
          <div>
            <% if(error){ %>
                <%= error %>
            <% } %>
          </div>
          <button class="btn btn-primary my-2" type="submit">Update User </button>

        </div>
      </form>
    </div>
  </body>
</html>
