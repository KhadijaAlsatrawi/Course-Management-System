<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Details</title>
    <link rel="stylesheet" href="/css/custom.css">
    <script defer src="/bootstrap-js/bootstrap.bundle.min.js"></script>
    <script defer src="/js/toast.js"></script>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="toast-container position-fixed end-0 p-3">
        <div id="dynamicToast" class="toast border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div id="dynamic-toast-body" class="toast-body"></div>
            </div>
        </div>
    </div>

    <div class="container pt-5">
        <h1>User Details</h1>
        <p><span class="fw-semibold">Username: </span><%= user.username %></p>
        <p><span class="fw-semibold">Role: </span><%= user.role.name %></p>
        <a href="/user/<%= user._id %>/change-password">Change Password</a>
    </div>
</body>
</html>