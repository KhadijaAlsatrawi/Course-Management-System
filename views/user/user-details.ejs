<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Details</title>
    <link rel="stylesheet" href="/css/custom.css">
    <script defer src="/bootstrap-js/bootstrap.bundle.min.js"></script>
    <script defer src="/js/toast.js"></script>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="toast-container position-fixed end-0 p-3">
        <div id="dynamicToast" class="toast border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div id="dynamic-toast-body" class="toast-body"></div>
            </div>
        </div>
    </div>

    <div class="container flex pt-5">
        <h1>User Details</h1>
        <div class="row pt-3">
            <div class="col-2">
                <img id="imagePreview" src="<%= user.profileImg %>"
                alt="profile image" class="profile-avatar ">
            </div>
            <div class="col-10">
            <h4><span class="fw-semibold">Username: </span><%= user.username %></h4>
            <p><span class="fw-semibold">Email: </span><%= user.email %></p>
            <p><span class="fw-semibold">Role: </span><%= user.role.name %></p>
            <a href="/user/<%= user._id %>/update" class="btn btn-outline-primary ">Update Information</a>
            <a href="/user/<%= user._id %>/change-password" class="btn btn-outline-primary ">Change Password</a>
            </div>
        </div>
    </div>
</body>
</html>