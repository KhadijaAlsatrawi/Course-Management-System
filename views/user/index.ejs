<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User List</title>
    <link rel="stylesheet" href="/css/custom.css">
    <script defer src="/bootstrap-js/bootstrap.bundle.min.js"></script>
    <script defer src="/js/search.js"></script>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>User List</h1>
    <a href="/user/new">Create New User</a>
    <div>
        <input id="search" type="text" placeholder="Search username">
    </div>
    <table class="display-table">
        <tr class="table-header">
            <th>Username</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
        <% for(let oneUser of users){ %>
            <tr class="table-row">
                <td><%= oneUser.username %></td>
                <td><%= oneUser.role.name %></td>
                <td>
                    <a href="/user/<%= oneUser._id %>/update">Update User</a>
                    <form action="/user/<%= oneUser._id %>?_method=DELETE" method="post">
                        <button>Delete User</button>
                    </form>
                </td>
            </tr>
        <% } %>
</body>
</html>