<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Update User</title>
    <link rel="stylesheet" href="/css/custom.css">
    <script defer src="/bootstrap-js/bootstrap.bundle.min.js"></script>
  </head>
  <body>
    <%- include('../partials/navbar') %>

    <div class="container py-5">
      <h1>Update <%= user.username %></h1>

      <form action="/user/<%= user._id %>/role=PUT" method="post">
        <div class="form-control border border-primary my-2">

          <label for="role">Role: </label>
          <select name="role" id="role"
          class="form-control border border-primary my-2">
            <% for(oneRole of roles){ %>
                <% if(String (oneRole._id) === String (user.role)){ %>
                    <option value="<%= oneRole._id %>" selected><%= oneRole.name %></option>
                <% }else{ %>
                    <option value="<%= oneRole._id %>"><%= oneRole.name %></option>
                <% } %>
            <% } %>
          </select>
          <div>
            <% if(error){ %>
                <%= error %>
            <% } %>
            </div>
          <button class="btn btn-primary my-2" type="submit">Update User </button>

        </div>
      </form>
    </div>
  </body>
</html>
