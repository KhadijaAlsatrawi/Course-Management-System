<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Change Password</title>
  <link rel="stylesheet" href="/css/custom.css">
  <script defer src="/bootstrap-js/bootstrap.bundle.min.js"></script>
</head>

<body>
  <%- include('../partials/navbar') %>

    <div class="container py-5">
      <h1>Change Password</h1>
      <h4>User: <%= user.username %></h4>

      <form action="/user/<%= user._id %>/change-password?_method=PUT" method="post">
        <div class="form-control border border-primary my-2">

          <label for="password">Password: </label>
          <input 
          type="password" 
          name="password" 
          id="password" 
          class="form-control border border-primary my-2"/>
          <label for="confirmPassword">Confirm Password: </label>
          <input 
          type="password" 
          name="confirmPassword" 
          id="confirmPassword" 
          class="form-control border border-primary my-2"/>

          <div>
            <% if(error){ %>
              <p class="text-danger"><%= error %></p>
            <% } %>
          </div>
          <button class="btn btn-primary my-2" type="submit">Change Password</button>

        </div>
      </form>
    </div>
</body>

</html>