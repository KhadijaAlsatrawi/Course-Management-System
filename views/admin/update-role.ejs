<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Role</title>
    <link rel="stylesheet" href="/css/custom.css">
    <script defer src="/bootstrap-js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container py-5">

        <h1>Create a new Role</h1>
        <form action="/admin/roles/<%= role._id %>?_method=PUT" method="post">
            <div class="form-control border border-primary my-2">

                <label for="name">Role name: </label>
                <input 
                    name="name"
                    id="name"
                    type="text"
                    required
                    class="form-control border border-primary my-2"
                    value="<%= role.name %>">

                <label for="description">Description: </label>
                <textarea 
                    name="description"
                    id="description"
                    required
                    class="form-control border border-primary my-2"
                    ><%= role.description %></textarea>
                <div>
                    <% if(error){ %>
                        <p class="text-danger"><%= error %></p>
                    <% } %>
                </div>

                <button class="btn btn-primary my-2" type="submit">Update Role</button>
            </div>
        </form>
    </div>
</body>
</html>