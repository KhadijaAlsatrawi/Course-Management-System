<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/css/custom.css">
    <script defer src="/bootstrap-js/bootstrap.bundle.min.js"></script>
    <script defer src="/js/search.js"></script>
    <script defer src="/js/toast.js"></script>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="toast-container position-fixed end-0 p-3">
        <div id="dynamicToast" class="toast border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div id="dynamic-toast-body" class="toast-body"></div>
            </div>
        </div>
    </div>

    <div class="container py-5">
        <h1>Admin Dashboard</h1>

        <div class="d-flex justify-content-left gap-2">
            <a href="/admin/roles" class="btn btn-sm btn-outline-primary">Roles List</a>
            <a href="/courses/new" class="btn btn-sm btn-outline-primary">Add new Course</a>
            <form action="/admin/export-to-pdf" method="get">
                <button id="export-btn" class="btn btn-sm btn-outline-primary">Export to PDF</button>
            </form>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 my-4">
            <h2 class="h2 mb-0">User List</h2>
            <a href="/user/new" class="btn btn-primary">+ Create New User</a>
        </div>

        <div class="px-3">
            <div class="mb-3">
                <input id="search" class="form-control" type="text" placeholder="Search username">
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0 display-table">
                    <tr class="table-header table-primary">
                        <th>Username</th>
                        <th>Role</th>
                        <th>Email</th>
                        <th>Actions</th>
                    </tr>
                    <% if (users.length===0) { %>
                        <tr>
                            <td colspan="4" class="text-muted py-4">No users found.</td>
                        </tr>
                    <% } %>
                    <% for (let oneUser of users) { %>
                        <tr class="table-row">
                            <td class="fw-semibold"><%= oneUser.username %></td>
                            <td><%= oneUser.role.name %></td>
                            <td><%= oneUser.email %></td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a href="/user/<%= oneUser._id %>/update-role"
                                        class="btn btn-sm btn-outline-primary">Update</a>
                                    <form action="/user/<%= oneUser._id %>?_method=DELETE" method="post">
                                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </table>
            </div>
        </div>
    </div>
</body>
</html>