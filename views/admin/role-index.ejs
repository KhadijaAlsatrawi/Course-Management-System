<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Role List</title>
    <link rel="stylesheet" href="/css/custom.css">
    <script defer src="/bootstrap-js/bootstrap.bundle.min.js"></script>
    <script defer src="/js/search.js"></script>
    <script defer src="/js/toast.js"></script>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="toast-container position-fixed end-0 p-3">
        <div id="dynamicToast" class="toast border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div id="dynamic-toast-body" class="toast-body"></div>
            </div>
        </div>
    </div>

    <div class="container py-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 my-4">
         <h1 class="h2 mb-0">Role List</h1>
            <a href="/admin/roles/new" class="btn btn-primary">+ Create New Role</a>
        </div>

        <div class="px-3">
            <div class="mb-3">
                <input id="search" class="form-control" type="text" placeholder="Search username">
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0 display-table">
                    <tr class="table-header table-primary">
                        <th>Name</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                    <% if (roles.length===0) { %>
                        <tr>
                            <td colspan="3" class="text-muted py-4">No roles found.</td>
                        </tr>
                    <% } %>
                    <% for (let oneRole of roles) { %>
                        <tr class="table-row">
                            <td class="fw-semibold"><%= oneRole.name %></td>
                            <td><%= oneRole.description %></td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a href="/admin/roles/<%= oneRole._id %>/update"
                                        class="btn btn-sm btn-outline-primary">Update</a>
                                    <form action="/admin/roles/<%= oneRole._id %>?_method=DELETE" method="post">
                                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </table>
            </div>
        </div>
    </div>
</body>
</html>